# GitHub personal access token with public read access, used server-side to
# fetch contribution/star data for the GitHub timeline section.
# Build and dev both fail loudly without this set.
GITHUB_TOKEN=

# Optional. Overrides the canonical site URL used for metadata (OG tags,
# sitemap, robots.txt). Falls back to VERCEL_URL, then https://anujajay.com.
NEXT_PUBLIC_SITE_URL=
